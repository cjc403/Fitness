  "rules": {
    "version": "new plan/session version0; draft/publish/archive/record increments plan; feedback/void increments session. All existing writes require expectedVersion. No auto retry of new versions.",
    "idempotency": "memberId+actorId+key unique; 8-80 ASCII letters/digits/_/-; permission and relation before lookup; SHA256 operation+target IDs+canonical JSON (sorted object keys, normalized decimals, trim only title/name/note/reason/content, preserve enum/key strings and array order). Same payload retry returns current original object including later archived/voided state; changed payload 2600. CREATE replay additionally authorizes the original plan against refreshed current coach/service venue before returning detail.",
    "memberPrivacy": "DRAFT omitted and by-id forbidden; events=[],eventTotal=0,venues=[],canEdit/canPublish/canArchive/canRecord=false; only own plans Member self-history stays readable when profile is inactive/blacklisted, but canFeedback=false and both new/past successful feedback keys are denied before deduplication; member state is refreshed after its row lock.",
    "archive": "COACH own related plan; MANAGER service venue and HQ readable plan may archive with reason, including after coach reassignment; no additional edit/record/void rights Supervisor archive explicitly allows inactive/blacklisted profiles and lost coach relationships, with current supervisor venue scope and reason.",
    "canViewBody": "UI visibility only: HQ true, accessible COACH true, MEMBER self true, MANAGER iff member home venue matches own. Existing body measurement permissions unchanged.",
    "history": "sessions paged default20 max100 includes COMPLETED/VOIDED; counts,last date,month stats exclude VOIDED; audit latest100 with eventTotal",
    "independentSession": "bookingId and courseName null identify independent record; frontend label 独立训练记录",
    "duplicatePlanNames": "allowed; session exerciseIds must each appear exactly once",
    "numbers": "JSON numbers remain numeric, nullable absent values remain null. Input Integer/Long fields require integer JSON tokens, no silent fractional truncation.",
    "goals": [
      "FAT_LOSS",
      "MUSCLE_GAIN",
      "POSTURE",
      "ENDURANCE",
      "GENERAL"
    ],
    "planStatus": [
      "DRAFT",
      "ACTIVE",
      "ARCHIVED"
    ],
    "sessionStatus": [
      "COMPLETED",
      "VOIDED"
    ],
    "exerciseStatus": [
      "DONE",
      "SKIPPED"
    ]
  },
  "errors": {
