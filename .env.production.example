# Copy values into user/system environment variables. Do not commit real secrets.
DB_URL=jdbc:postgresql://localhost:5433/fitness_db
DB_USERNAME=fitness_user
DB_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
APP_ADMIN_PASSWORD=replace-with-a-strong-admin-login-password
MANAGEMENT_ADDRESS=127.0.0.1
MANAGEMENT_PORT=9091
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=700
AI_REQUESTS_PER_MINUTE=10
# V2 rollout controls; only enable after the matching local schema and acceptance.
AI_TASK_V2_ENABLED=true
AI_PLANNER_THINKING_ENABLED=true
# Comma-separated groups: navigation,messages,courses,members,leads,retention,training,operations
AI_TASK_DISABLED_SKILLS=
