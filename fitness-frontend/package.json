{
  "name": "fitness-frontend",
  "version": "1.0.0",
  "type": "module",
  "description": "健身房管理系统前端",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --host 0.0.0.0 --port 5174 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "test:agent-v2": "node --test tests/agent-v2/*.test.mjs",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.6.5",
    "element-plus": "^2.5.8",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "vue": "^3.4.21",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/eslint-config-typescript": "^13.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.19.2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vue-tsc": "3.3.11"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
