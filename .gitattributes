# 统一换行符：Flyway 按文件字节算 checksum，CRLF/LF 不同会被判为"迁移文件被改动"而拒绝启动。
# 服务器上的 V1–V8 是 LF（与 git 里存储的一致），因此这里强制文本文件按 LF 检出。
* text=auto
*.sql text eol=lf
*.java text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.mjs text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.html text eol=lf

# 已在本地应用的这三个新增迁移使用 CRLF，归档时必须保存原字节。
# 禁止在 git add / checkout 时归一化；其他迁移继续按现有 LF 约定。
fitness-backend/src/main/resources/db/migration/V18__revocable_account_sessions.sql -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
fitness-backend/src/main/resources/db/migration/V21__cash_shifts_and_daily_close.sql -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
fitness-backend/src/main/resources/db/migration/V22__training_plans_and_sessions.sql -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
